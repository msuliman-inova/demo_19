<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job Seeker Convert Wizard Form -->
    <record id="view_job_seeker_convert_wizard_form" model="ir.ui.view">
        <field name="name">job.seeker.convert.wizard.form</field>
        <field name="model">job.seeker.convert.wizard</field>
        <field name="arch" type="xml">
            <form string="Convert to Job Application">
                <group>
                    <group string="Job Seeker Information">
                        <field name="seeker_id" invisible="1"/>
                        <field name="seeker_name" readonly="1"/>
                        <field name="seeker_email" readonly="1"/>
                        <field name="seeker_phone" readonly="1"/>
                        <field name="seeker_position" readonly="1"/>
                    </group>
                    <group string="Select Job Position">
                        <field name="job_id" options="{'no_create': True}"/>
                        <field name="department_id" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Create Application" name="action_convert" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
