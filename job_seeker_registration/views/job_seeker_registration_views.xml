    <!-- Job Seeker Registration Action -->
    <record id="action_job_seeker_registration" model="ir.actions.act_window">
        <field name="name">Job Seeker Registrations</field>
        <field name="res_model">job.seeker.registration</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_not_converted': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No job seeker registrations yet
            </p>
            <p>
                Job seekers can register their interest for future positions from the website jobs page.
            </p>
        </field>
    </record>
</odoo>
