<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Job Seeker Registration List View -->
    <record id="view_job_seeker_registration_list" model="ir.ui.view">
        <field name="name">job.seeker.registration.list</field>
        <field name="model">job.seeker.registration</field>
        <field name="arch" type="xml">
            <list string="Job Seeker Registrations" sample="1">
                <field name="create_date" string="Registration Date"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="job_position"/>
                <field name="department_id"/>
                <field name="experience_years"/>
                <field name="state" decoration-success="state == 'converted'" decoration-info="state == 'interested'" decoration-muted="state == 'not_interested'"/>
                <field name="application_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Job Seeker Registration Form View -->
    <record id="view_job_seeker_registration_form" model="ir.ui.view">
        <field name="name">job.seeker.registration.form</field>
        <field name="model">job.seeker.registration</field>
        <field name="arch" type="xml">
            <form string="Job Seeker Registration">
                <header>
                    <button name="action_convert_to_application" string="Convert to Application"
                            type="object" class="oe_highlight"
                            invisible="state == 'converted'"/>
                    <button name="action_contact_seeker" string="Mark as Contacted"
                            type="object" invisible="state not in ['new']"/>
                    <button name="action_mark_interested" string="Still Interested"
                            type="object" invisible="state == 'converted'"/>
                    <button name="action_mark_not_interested" string="Not Interested"
                            type="object" invisible="state in ['converted', 'not_interested']"/>
                    <button name="action_view_application" string="View Application"
                            type="object" class="oe_highlight"
                            invisible="state != 'converted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,contacted,interested,converted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_application" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="application_count == 0">
                            <field name="application_count" widget="statbutton" string="Application"/>
                        </button>
                    </div>
                    <group>
                        <group string="Applicant Information">
                            <field name="name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Position Details">
                            <field name="job_position"/>
                            <field name="department_id"/>
                            <field name="expected_salary" widget="monetary"/>
                            <field name="availability_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Qualifications">
                            <field name="degree_id"/>
                            <field name="experience_years"/>
                        </group>
                        <group string="Documents">
                            <field name="resume" filename="resume_filename"/>
                            <field name="resume_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cover Letter" name="cover_letter">
                            <field name="cover_letter" placeholder="Cover letter or additional information..."/>
                        </page>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this candidate..."/>
                        </page>
                        <page string="Conversion Info" name="conversion" invisible="state != 'converted'">
                            <group>
                                <field name="application_id"/>
                                <field name="converted_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Job Seeker Registration Kanban View -->
    <record id="view_job_seeker_registration_kanban" model="ir.ui.view">
        <field name="name">job.seeker.registration.kanban</field>
        <field name="model">job.seeker.registration</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="job_position"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <br/>
                                    <span class="text-muted"><field name="job_position"/></span>
                                </div>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'new': 'default', 'contacted': 'info', 'interested': 'success', 'not_interested': 'warning', 'converted': 'success'}}"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><i class="fa fa-envelope" title="Email"/> <field name="email"/></span><br/>
                                    <span><i class="fa fa-phone" title="Phone"/> <field name="phone"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

