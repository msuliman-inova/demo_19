<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add CSS to hide recruiter sidebar on thank you page -->
    <template id="thankyou_hide_recruiter_css" name="Hide Recruiter Sidebar CSS" inherit_id="website.layout">
        <xpath expr="//head" position="inside">
            <style>
                /* Hide recruiter contact information sidebar on thank you page */
                #jobs_thankyou .row.pt24.pb24 > .col-lg-4.align-self-center {
                    display: none !important;
                }
                /* Make the main content full width */
                #jobs_thankyou .row.pt24.pb24 > .col.pt24.pb24.text-center {
                    flex: 0 0 100%;
                    max-width: 100%;
                }
            </style>
        </xpath>
    </template>

    <!-- Add Filters Bar -->
    <template id="jobs_filters_bar" inherit_id="website_hr_recruitment.index" name="Jobs Filters Bar">
        <xpath expr="//div[@id='jobs_grid']" position="before">
            <div class="col-12 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="fa fa-filter"/> Filter Jobs
                        </h5>
                        <form method="get" action="/jobs" id="jobs_filter_form">
                            <div class="row g-3">
                                <!-- Department Filter -->
                                <div class="col-md-4">
                                    <label for="department_filter" class="form-label">
                                        <i class="fa fa-sitemap"/> Department
                                    </label>
                                    <select name="department_id" id="department_filter" class="form-select" onchange="this.form.submit()">
                                        <option value="">All Departments</option>
                                        <t t-foreach="all_departments or []" t-as="dept">
                                            <option t-att-value="dept.id" t-att-selected="'selected' if selected_department == dept.id else None">
                                                <t t-out="dept.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <!-- Contract Type Filter -->
                                <div class="col-md-4">
                                    <label for="contract_type_filter" class="form-label">
                                        <i class="fa fa-suitcase"/> Contract Type
                                    </label>
                                    <select name="contract_type_id" id="contract_type_filter" class="form-select" onchange="this.form.submit()">
                                        <option value="">All Contract Types</option>
                                        <t t-foreach="all_contract_types or []" t-as="contract">
                                            <option t-att-value="contract.id" t-att-selected="'selected' if selected_contract_type == contract.id else None">
                                                <t t-out="contract.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <!-- Location Filter -->
                                <!--<div class="col-md-4">
                                    <label for="location_filter" class="form-label">
                                        <i class="fa fa-map-marker"/> Location
                                    </label>
                                    <select name="office_id" id="location_filter" class="form-select" onchange="this.form.submit()">
                                        <option value="">All Locations</option>
                                        <t t-foreach="all_offices or []" t-as="office">
                                            <option t-att-value="office.id" t-att-selected="'selected' if selected_office == office.id else None">
                                                <t t-if="office.city">
                                                    <t t-out="office.city"/>
                                                    <t t-if="office.country_id">, <t t-out="office.country_id.name"/></t>
                                                </t>
                                                <t t-else="">
                                                    <t t-out="office.name or 'Unknown'"/>
                                                </t>
                                            </option>
                                        </t>
                                    </select>
                                </div>-->
                            </div>

                            <!-- Clear Filters Button -->
                            <div class="row mt-3" t-if="selected_department or selected_contract_type or selected_office">
                                <div class="col-12">
                                    <a href="/jobs" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa fa-times"/> Clear All Filters
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

