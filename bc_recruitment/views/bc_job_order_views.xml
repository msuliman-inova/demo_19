<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Job Order List View -->
    <record id="bc_job_order_view_list" model="ir.ui.view">
        <field name="name">bc.job.order.list</field>
        <field name="model">bc.job.order</field>
        <field name="arch" type="xml">
            <list string="Job Orders" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="job_title"/>
                <field name="positions_requested"/>
                <field name="positions_filled"/>
                <field name="fill_rate" widget="progressbar"/>
                <field name="expected_start_date"/>
                <field name="priority" widget="priority"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'in_progress'"/>
                <field name="user_id" widget="many2one_avatar_user" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Job Order Form View -->
    <record id="bc_job_order_view_form" model="ir.ui.view">
        <field name="name">bc.job.order.form</field>
        <field name="model">bc.job.order</field>
        <field name="arch" type="xml">
            <form string="Job Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Processing" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_create_placement" string="Create Placement" type="object"
                            class="btn-primary" invisible="state not in ['confirmed', 'in_progress'] or positions_remaining == 0"/>
                    <button name="action_create_bulk_invoices" string="Create Bulk Invoices" type="object"
                            class="btn-warning" invisible="state not in ['in_progress', 'completed'] or placement_count == 0"
                            help="Create invoices for all non-invoiced active/completed placements"/>
                    <button name="action_complete" string="Mark Complete" type="object"
                            class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_reset_to_in_progress" string="Reset to In Progress" type="object"
                            class="btn-warning" invisible="state != 'completed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Sale Order</span>
                            </div>
                        </button>
                        <button name="action_view_placements" type="object" class="oe_stat_button"
                                icon="fa-users" invisible="placement_count == 0">
                            <field name="placement_count" widget="statinfo" string="Placements"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Client Information">
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="sale_line_id" options="{'no_create': True}" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="sale_order_display" readonly="1" string="Order Details"/>
                            <field name="user_id" readonly="state in ['completed', 'cancelled']"/>
                            <field name="priority" widget="priority" readonly="state in ['completed', 'cancelled']"/>
                        </group>
                        <group string="Status">
                            <label for="positions_requested" string="Positions"/>
                            <div class="o_row">
                                <field name="positions_requested" readonly="1"/>
                                <span>/</span>
                                <field name="positions_filled" readonly="1"/>
                                <span>filled</span>
                            </div>
                            <field name="positions_remaining"/>
                            <field name="fill_rate" widget="progressbar"/>
                            <field name="deadline" readonly="state in ['completed', 'cancelled']"/>
                        </group>
                    </group>

                    <group>
                        <group string="Job Details">
                            <field name="job_title" readonly="state in ['completed', 'cancelled']"/>
                            <field name="skill_ids" widget="many2many_tags" readonly="state in ['completed', 'cancelled']"/>
                            <field name="contract_type" readonly="state in ['completed', 'cancelled']"/>
                            <field name="expected_start_date" readonly="state in ['completed', 'cancelled']"/>
                            <field name="contract_duration_months" invisible="contract_type not in ['temporary', 'contract', 'seasonal']" readonly="state in ['completed', 'cancelled']"/>
                        </group>
                        <group string="Location">
                            <field name="work_location" readonly="state in ['completed', 'cancelled']"/>
                            <field name="country_id" readonly="state in ['completed', 'cancelled']"/>
                        </group>
                    </group>

                    <group string="Salary &amp; Benefits">
                        <group>
                            <label for="salary_from" string="Salary Range"/>
                            <div class="o_row">
                                <field name="salary_from" widget="monetary" readonly="state in ['completed', 'cancelled']"/>
                                <span>-</span>
                                <field name="salary_to" widget="monetary" readonly="state in ['completed', 'cancelled']"/>
                            </div>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <field name="job_description" placeholder="Job description and requirements..."/>
                        </page>

                        <page string="Benefits" name="benefits">
                            <field name="benefits" placeholder="Benefits and perks offered..."/>
                        </page>

                        <page string="Placements" name="placements">
                            <field name="placement_ids" nolabel="1">
                                <list editable="bottom" delete="0" create="1">
                                    <field name="name"/>
                                    <field name="worker_id"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="salary" widget="monetary"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Job Order Kanban View -->
    <record id="bc_job_order_view_kanban" model="ir.ui.view">
        <field name="name">bc.job.order.kanban</field>
        <field name="model">bc.job.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="job_title"/>
                <field name="positions_requested"/>
                <field name="positions_filled"/>
                <field name="fill_rate"/>
                <field name="state"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="partner_id"/>
                                        </div>
                                    </div>
                                    <div>
                                        <field name="priority" widget="priority"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="job_title"/>
                                    <div>
                                        <i class="fa fa-users"/>
                                        <t t-esc="record.positions_filled.raw_value"/>/<t t-esc="record.positions_requested.raw_value"/>
                                        positions filled
                                    </div>
                                    <div>
                                        <field name="fill_rate" widget="progressbar"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="expected_start_date" widget="date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Job Order Search View -->
    <record id="bc_job_order_view_search" model="ir.ui.view">
        <field name="name">bc.job.order.search</field>
        <field name="model">bc.job.order</field>
        <field name="arch" type="xml">
            <search string="Job Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="job_title"/>
                <field name="skill_ids"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="High Priority" name="high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                <filter string="Positions Available" name="positions_available" domain="[('positions_remaining', '>', 0)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Contract Type" name="group_contract" context="{'group_by': 'contract_type'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bc_job_order" model="ir.actions.act_window">
        <field name="name">Job Orders</field>
        <field name="res_model">bc.job.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first job order
            </p>
            <p>
                Job orders are automatically created from confirmed sale orders.
                You can also create them manually.
            </p>
        </field>
    </record>

</odoo>
