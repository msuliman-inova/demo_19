<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit CRM Lead Form View -->
    <record id="view_crm_lead_form_bc_recruitment" model="ir.ui.view">
        <field name="name">crm.lead.form.bc.recruitment</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Add BC Recruitment checkbox in header area -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="is_bc_recruitment"/>
            </xpath>

            <xpath expr="//page[@name='extra']" position="before">
                <page string="BC Recruitment" name="bc_recruitment" invisible="not is_bc_recruitment">
                    <group>
                        <group>
                            <field name="required_workers"/>
                            <field name="job_category"/>
                        </group>
                        <group>
                            <field name="work_location"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Hide "Convert to Local Recruitment" button when is_bc_recruitment is checked -->
    <record id="view_crm_lead_form_hide_local_recruitment" model="ir.ui.view">
        <field name="name">crm.lead.form.hide.local.recruitment</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="recruitment_management.view_crm_lead_form_recruitment_convert_button"/>
        <field name="arch" type="xml">
            <xpath expr="//button[hasclass('btn_convert_local_recruitment')]" position="attributes">
                <attribute name="invisible">is_recruitment_lead or type == 'lead' or is_bc_recruitment</attribute>
            </xpath>
        </field>
    </record>

</odoo>
