<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Placement List View -->
    <record id="bc_placement_view_list" model="ir.ui.view">
        <field name="name">bc.placement.list</field>
        <field name="model">bc.placement</field>
        <field name="arch" type="xml">
            <list string="Placements" sample="1">
                <field name="name"/>
                <field name="worker_id"/>
                <field name="job_order_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="visa_status" optional="show" widget="badge"
                       decoration-info="visa_status == 'mol'"
                       decoration-warning="visa_status == 'immigration_typing'"
                       decoration-primary="visa_status == 'immigration_approval'"
                       decoration-success="visa_status == 'visa_issued'"/>
                <field name="invoiced" widget="boolean_toggle"/>
                <field name="state"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'assigned'"
                       decoration-success="state in ['active', 'completed']"
                       decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <!-- Placement Form View -->
    <record id="bc_placement_view_form" model="ir.ui.view">
        <field name="name">bc.placement.form</field>
        <field name="model">bc.placement</field>
        <field name="arch" type="xml">
            <form string="Placement">
                <header>
                    <button name="action_assign" string="Assign Worker" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_complete" string="Complete" type="object"
                            class="btn-success" invisible="state != 'active'"/>
                    <button name="action_reject_unassign" string="Reject/Unassign" type="object"
                            class="btn-warning" invisible="state not in ['assigned', 'active']"
                            confirm="Are you sure you want to reject/unassign this worker?"/>
                    <button name="action_terminate" string="Terminate" type="object"
                            class="btn-danger" invisible="state not in ['assigned', 'active']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ['draft', 'assigned']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,active,completed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Assignment">
                            <field name="job_order_id" context="{'tree_view_ref': 'bc_recruitment.bc_job_order_view_list'}" readonly="1"/>
                            <field name="worker_id" domain="[('availability_status', '=', 'available')]" readonly="state not in ['draft']"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                        <group string="Job Details">
                            <field name="job_title" readonly="1"/>
                            <field name="work_location" readonly="1"/>
                            <field name="contract_type" readonly="state not in ['draft', 'assigned']"/>
                            <field name="visa_status" readonly="state in ['completed', 'terminated', 'cancelled']"/>
                        </group>
                    </group>

                    <group>
                        <group string="Contract Period">
                            <field name="start_date" readonly="state in ['completed', 'terminated', 'cancelled']"/>
                            <field name="end_date" readonly="state in ['completed', 'terminated', 'cancelled']"/>
                            <field name="duration_months"/>
                            <field name="actual_end_date" invisible="state not in ['completed', 'terminated']"/>
                        </group>
                        <group string="Financial">
                            <field name="salary" widget="monetary" readonly="state in ['completed', 'terminated', 'cancelled']"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="invoiced" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Performance" name="performance" invisible="state in ['draft', 'assigned']">
                            <group>
                                <group>
                                    <field name="performance_rating" widget="priority"/>
                                </group>
                            </group>
                            <group string="Client Feedback">
                                <field name="client_feedback" nolabel="1" placeholder="Client feedback and comments..."/>
                            </group>
                        </page>

                        <page string="Termination" name="termination" invisible="state != 'terminated'">
                            <group>
                                <field name="termination_date"/>
                                <field name="termination_reason" nolabel="1" placeholder="Reason for termination..."/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes about this placement..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Placement Kanban View -->
    <record id="bc_placement_view_kanban" model="ir.ui.view">
        <field name="name">bc.placement.kanban</field>
        <field name="model">bc.placement</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="worker_id"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="state"/>
                <field name="visa_status"/>
                <field name="invoiced"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="worker_id"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="partner_id"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="job_title"/>
                                    <div>
                                        <i class="fa fa-calendar" title="Start Date"/>
                                        <field name="start_date" widget="date"/>
                                    </div>
                                    <div t-if="record.visa_status.raw_value" class="mt-2">
                                        <span class="badge badge-pill badge-info">
                                            <i class="fa fa-id-card-o" title="Visa Status"/> <field name="visa_status"/>
                                        </span>
                                    </div>
                                    <div>
                                        <field name="invoiced" widget="boolean"
                                               decoration-success="invoiced == True"/>
                                        <span t-if="record.invoiced.raw_value">Invoiced</span>
                                        <span t-else="">Not Invoiced</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Placement Search View -->
    <record id="bc_placement_view_search" model="ir.ui.view">
        <field name="name">bc.placement.search</field>
        <field name="model">bc.placement</field>
        <field name="arch" type="xml">
            <search string="Placements">
                <field name="name"/>
                <field name="worker_id"/>
                <field name="partner_id"/>
                <field name="job_order_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="Active" name="active_placements" domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Not Invoiced" name="not_invoiced" domain="[('invoiced', '=', False), ('state', 'in', ['active', 'completed'])]"/>
                <filter string="Invoiced" name="invoiced" domain="[('invoiced', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="MOL - Labor Approval" name="visa_mol" domain="[('visa_status', '=', 'mol')]"/>
                <filter string="Immigration Typing" name="visa_typing" domain="[('visa_status', '=', 'immigration_typing')]"/>
                <filter string="Immigration Approval" name="visa_approval" domain="[('visa_status', '=', 'immigration_approval')]"/>
                <filter string="Visa Issued" name="visa_issued" domain="[('visa_status', '=', 'visa_issued')]"/>
                <group name="group_by">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Visa Status" name="group_visa_status" context="{'group_by': 'visa_status'}"/>
                    <filter string="Worker" name="group_worker" context="{'group_by': 'worker_id'}"/>
                    <filter string="Client" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Job Order" name="group_job_order" context="{'group_by': 'job_order_id'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'start_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bc_placement" model="ir.actions.act_window">
        <field name="name">Placements</field>
        <field name="res_model">bc.placement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_active_placements': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first placement
            </p>
            <p>
                Placements assign workers to specific job orders and track their assignments.
            </p>
        </field>
    </record>

</odoo>
