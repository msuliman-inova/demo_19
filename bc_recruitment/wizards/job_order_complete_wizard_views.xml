<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Job Order Complete Wizard Form View -->
    <record id="view_job_order_complete_wizard_form" model="ir.ui.view">
        <field name="name">job.order.complete.wizard.form</field>
        <field name="model">job.order.complete.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Job Order Completion">
                <sheet>
                    <group>
                        <field name="job_order_id" readonly="1"/>
                    </group>

                    <div class="alert alert-warning" role="alert">
                        <strong><i class="fa fa-warning"/> Warning:</strong> Not all positions have been filled for this job order.
                    </div>

                    <group string="Position Summary">
                        <field name="positions_requested" readonly="1"/>
                        <field name="positions_filled" readonly="1"/>
                        <field name="positions_remaining" readonly="1"/>
                    </group>

                    <separator/>

                    <group>
                        <label for="confirm_completion" string="Confirmation"/>
                        <div>
                            <field name="confirm_completion" widget="boolean_toggle"/>
                            <div class="text-muted" style="margin-top: 8px;">
                                I agree to mark this job order as completed even though not all positions are filled
                            </div>
                        </div>
                    </group>
                </sheet>

                <footer>
                    <button string="Mark as Completed" name="action_confirm_complete" type="object" class="btn-primary" invisible="not confirm_completion"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
