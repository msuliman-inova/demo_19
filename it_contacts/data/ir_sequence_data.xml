<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_it_contacts_customer_code" model="ir.sequence">
            <field name="name">Contact Customer Code</field>
            <field name="code">it.contacts.customer.code</field>
            <field name="prefix">CU-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_it_contacts_supplier_code" model="ir.sequence">
            <field name="name">Contact Supplier Code</field>
            <field name="code">it.contacts.supplier.code</field>
            <field name="prefix">SU-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
