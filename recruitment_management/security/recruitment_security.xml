<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- User Groups for Odoo 19 -->
        <record id="group_recruitment_user" model="res.groups">
            <field name="name">Recruitment Management / Officer</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_recruitment_manager" model="res.groups">
            <field name="name">Recruitment Management / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_recruitment_user'))]"/>
        </record>

        <record id="group_recruitment_portal" model="res.groups">
            <field name="name">Recruitment Management / Portal - Employer</field>
        </record>

        <!-- Record Rules -->

        <!-- Recruitment Request Rules -->
        <record id="recruitment_request_user_rule" model="ir.rule">
            <field name="name">Recruitment Request: User</field>
            <field name="model_id" ref="model_recruitment_request"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_user'))]"/>
        </record>

        <record id="recruitment_request_manager_rule" model="ir.rule">
            <field name="name">Recruitment Request: Manager - All</field>
            <field name="model_id" ref="model_recruitment_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_manager'))]"/>
        </record>

        <record id="recruitment_request_portal_rule" model="ir.rule">
            <field name="name">Recruitment Request: Portal User - Own Requests</field>
            <field name="model_id" ref="model_recruitment_request"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Pricing Rules -->
        <record id="recruitment_pricing_user_rule" model="ir.rule">
            <field name="name">Recruitment Pricing: User - Read Only</field>
            <field name="model_id" ref="model_recruitment_pricing"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="recruitment_pricing_manager_rule" model="ir.rule">
            <field name="name">Recruitment Pricing: Manager - All</field>
            <field name="model_id" ref="model_recruitment_pricing"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_manager'))]"/>
        </record>

        <!-- Additional Services Rules -->
        <record id="recruitment_additional_service_user_rule" model="ir.rule">
            <field name="name">Additional Services: User - Read Only</field>
            <field name="model_id" ref="model_recruitment_additional_service"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="recruitment_additional_service_manager_rule" model="ir.rule">
            <field name="name">Additional Services: Manager - All</field>
            <field name="model_id" ref="model_recruitment_additional_service"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_recruitment_manager'))]"/>
        </record>

    </data>
</odoo>
