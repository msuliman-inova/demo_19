<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Recruitment Sales Team -->
        <record id="recruitment_sales_team" model="crm.team">
            <field name="name">Recruitment Team</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
        </record>

        <!-- Product: Recruitment Service -->
        <record id="product_recruitment_service" model="product.product">
            <field name="name">Recruitment Service</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_services"/>
            <field name="list_price">1000.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">delivery</field>
            <field name="service_type">manual</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
            <field name="description_sale">Professional recruitment service for finding qualified candidates</field>
        </record>

        <!-- Product: Background Check Service -->
        <record id="product_background_check" model="product.product">
            <field name="name">Background Check Service</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_services"/>
            <field name="list_price">150.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">order</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>

        <!-- Product: Skills Assessment -->
        <record id="product_skills_assessment" model="product.product">
            <field name="name">Skills Assessment Service</field>
            <field name="type">service</field>
            <field name="categ_id" ref="product.product_category_services"/>
            <field name="list_price">200.0</field>
            <field name="standard_price">0.0</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="invoice_policy">order</field>
            <field name="sale_ok">True</field>
            <field name="purchase_ok">False</field>
        </record>

        <!-- Default Pricing Rules -->

        <!-- Permanent Contract Type - Salary Based Tiers -->
        <record id="pricing_permanent_entry" model="recruitment.pricing">
            <field name="name">Permanent - Entry Level (0-3,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_permanent"/>
            <field name="min_experience">0</field>
            <field name="max_experience">1</field>
            <field name="min_salary">0.0</field>
            <field name="max_salary">3000.0</field>
            <field name="percentage">8.0</field>
        </record>

        <record id="pricing_permanent_junior" model="recruitment.pricing">
            <field name="name">Permanent - Junior (3,001-5,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_permanent"/>
            <field name="min_experience">1</field>
            <field name="max_experience">3</field>
            <field name="min_salary">3001.0</field>
            <field name="max_salary">5000.0</field>
            <field name="percentage">10.0</field>
        </record>

        <record id="pricing_permanent_mid" model="recruitment.pricing">
            <field name="name">Permanent - Mid-Level (5,001-10,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_permanent"/>
            <field name="min_experience">3</field>
            <field name="max_experience">6</field>
            <field name="min_salary">5001.0</field>
            <field name="max_salary">10000.0</field>
            <field name="percentage">15.0</field>
        </record>

        <record id="pricing_permanent_senior" model="recruitment.pricing">
            <field name="name">Permanent - Senior (10,001-20,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_permanent"/>
            <field name="min_experience">6</field>
            <field name="max_experience">10</field>
            <field name="min_salary">10001.0</field>
            <field name="max_salary">20000.0</field>
            <field name="percentage">18.0</field>
        </record>

        <record id="pricing_permanent_executive" model="recruitment.pricing">
            <field name="name">Permanent - Executive (20,001+)</field>
            <field name="emp_contract_type" ref="hr.contract_type_permanent"/>
            <field name="min_experience">10</field>
            <field name="max_experience">99</field>
            <field name="min_salary">20001.0</field>
            <field name="max_salary">999999.0</field>
            <field name="percentage">20.0</field>
        </record>

        <!-- Temporary Contract Type - Salary Based Tiers -->
        <record id="pricing_temporary_entry" model="recruitment.pricing">
            <field name="name">Temporary - Entry Level (0-3,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_temporary"/>
            <field name="min_experience">0</field>
            <field name="max_experience">2</field>
            <field name="min_salary">0.0</field>
            <field name="max_salary">3000.0</field>
            <field name="percentage">5.0</field>
        </record>

        <record id="pricing_temporary_mid" model="recruitment.pricing">
            <field name="name">Temporary - Mid Level (3,001-8,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_temporary"/>
            <field name="min_experience">2</field>
            <field name="max_experience">5</field>
            <field name="min_salary">3001.0</field>
            <field name="max_salary">8000.0</field>
            <field name="percentage">7.0</field>
        </record>

        <record id="pricing_temporary_senior" model="recruitment.pricing">
            <field name="name">Temporary - Senior (8,001+)</field>
            <field name="emp_contract_type" ref="hr.contract_type_temporary"/>
            <field name="min_experience">5</field>
            <field name="max_experience">99</field>
            <field name="min_salary">8001.0</field>
            <field name="max_salary">999999.0</field>
            <field name="percentage">10.0</field>
        </record>

        <!-- Contract/Interim Type - Salary Based Tiers -->
        <record id="pricing_contract_entry" model="recruitment.pricing">
            <field name="name">Contract - Entry Level (0-4,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_interim"/>
            <field name="min_experience">0</field>
            <field name="max_experience">2</field>
            <field name="min_salary">0.0</field>
            <field name="max_salary">4000.0</field>
            <field name="percentage">6.0</field>
        </record>

        <record id="pricing_contract_mid" model="recruitment.pricing">
            <field name="name">Contract - Mid Level (4,001-12,000)</field>
            <field name="emp_contract_type" ref="hr.contract_type_interim"/>
            <field name="min_experience">2</field>
            <field name="max_experience">6</field>
            <field name="min_salary">4001.0</field>
            <field name="max_salary">12000.0</field>
            <field name="percentage">12.0</field>
        </record>

        <record id="pricing_contract_senior" model="recruitment.pricing">
            <field name="name">Contract - Senior (12,001+)</field>
            <field name="emp_contract_type" ref="hr.contract_type_interim"/>
            <field name="min_experience">6</field>
            <field name="max_experience">99</field>
            <field name="min_salary">12001.0</field>
            <field name="max_salary">999999.0</field>
            <field name="percentage">15.0</field>
        </record>


        <!-- Additional Services -->
        <record id="additional_service_background_check" model="recruitment.additional.service">
            <field name="name">Background Check</field>
            <field name="description">Comprehensive background verification including employment history, education, and
                criminal record check
            </field>
            <field name="product_id" ref="product_background_check"/>
            <field name="price">150.0</field>
        </record>

        <record id="additional_service_skills_assessment" model="recruitment.additional.service">
            <field name="name">Skills Assessment</field>
            <field name="description">Technical and soft skills assessment through standardized testing</field>
            <field name="product_id" ref="product_skills_assessment"/>
            <field name="price">200.0</field>
        </record>

        <record id="additional_service_psychometric" model="recruitment.additional.service">
            <field name="name">Psychometric Testing</field>
            <field name="description">Personality and aptitude assessment to ensure cultural fit</field>
            <field name="product_id" ref="product_recruitment_service"/>
            <field name="price">250.0</field>
        </record>

        <record id="additional_service_video_interview" model="recruitment.additional.service">
            <field name="name">Video Interview Setup</field>
            <field name="description">Professional video interview coordination and recording</field>
            <field name="product_id" ref="product_recruitment_service"/>
            <field name="price">100.0</field>
        </record>

    </data>
</odoo>