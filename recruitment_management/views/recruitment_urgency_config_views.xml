<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="recruitment_urgency_config_view_form" model="ir.ui.view">
        <field name="name">recruitment.urgency.config.form</field>
        <field name="model">recruitment.urgency.config</field>
        <field name="arch" type="xml">
            <form string="Urgency Configuration" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <p class="text-muted">
                            Configure the thresholds and colors for candidate urgency alerts shown to customers in the portal.
                        </p>
                    </div>

                    <group>
                        <group string="Urgency Thresholds (Days)">
                            <field name="urgency_urgent_days"/>
                            <field name="urgency_attention_days"/>
                        </group>
                        <group string="Color Indicators (Fixed)">
                            <div class="o_row">
                                <span class="badge" style="background-color: #dc3545; color: white; padding: 0.5rem 1rem;">Overdue - Red</span>
                            </div>
                            <div class="o_row">
                                <span class="badge" style="background-color: #fd7e14; color: white; padding: 0.5rem 1rem;">Urgent - Orange</span>
                            </div>
                            <div class="o_row">
                                <span class="badge" style="background-color: #ffc107; color: white; padding: 0.5rem 1rem;">Attention - Yellow</span>
                            </div>
                            <div class="o_row">
                                <span class="badge" style="background-color: #28a745; color: white; padding: 0.5rem 1rem;">Normal - Green</span>
                            </div>
                        </group>
                    </group>

                    <separator/>

                    <group>
                        <group>
                            <div>
                                <h4>How It Works</h4>
                                <div class="text-muted mt-2">
                                    <p><span class="badge" style="background-color: #dc3545; color: white;">Overdue</span> Past the deadline - immediate hiring decision required</p>
                                    <p><span class="badge" style="background-color: #fd7e14; color: white;">Urgent</span> Within <strong><field name="urgency_urgent_days" readonly="1" class="oe_inline"/></strong> days or less - quick decision needed</p>
                                    <p><span class="badge" style="background-color: #ffc107; color: white;">Attention</span> Within <strong><field name="urgency_attention_days" readonly="1" class="oe_inline"/></strong> days or less - should review soon</p>
                                    <p><span class="badge" style="background-color: #28a745; color: white;">Normal</span> More than <strong><field name="urgency_attention_days" readonly="1" class="oe_inline"/></strong> days - on track</p>
                                </div>
                            </div>
                        </group>
                        <group>
                            <div class="alert alert-warning" role="alert">
                                <p class="mb-0"><i class="fa fa-warning" title="Warning"/> <strong>Important:</strong> The Attention threshold must be greater than the Urgent threshold.</p>
                            </div>
                        </group>
                    </group>

                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="recruitment_urgency_config_view_tree" model="ir.ui.view">
        <field name="name">recruitment.urgency.config.tree</field>
        <field name="model">recruitment.urgency.config</field>
        <field name="arch" type="xml">
            <list string="Urgency Configurations" create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="urgency_urgent_days"/>
                <field name="urgency_attention_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_recruitment_urgency_config" model="ir.actions.act_window">
        <field name="name">Urgency Settings</field>
        <field name="res_model">recruitment.urgency.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="default_recruitment_urgency_config"/>
    </record>

</odoo>
