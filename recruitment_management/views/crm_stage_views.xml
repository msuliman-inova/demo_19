<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_stage_form_inherit" model="ir.ui.view">
        <field name="name">crm.stage.form.inherit.recruitment</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_won']" position="after">
                <field name="is_new" widget="boolean_toggle"/>
                <field name="is_in_progress" widget="boolean_toggle"/>
                <field name="is_confirmed" widget="boolean_toggle"/>
                <field name="is_completed" widget="boolean_toggle"/>
                <field name="is_lost" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
