    <!-- Calendar View -->
    <record id="recruitment_request_view_calendar" model="ir.ui.view">
        <field name="name">recruitment.request.calendar</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <calendar date_start="submission_date" color="user_id" mode="month">
                <field name="name"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="recruitment_request_view_pivot" model="ir.ui.view">
        <field name="name">recruitment.request.pivot</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="state" type="col"/>
                <field name="no_of_positions" type="measure"/>
                <!-- <field name="final_amount" type="measure"/> Removed as per requirement -->
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="recruitment_request_view_graph" model="ir.ui.view">
        <field name="name">recruitment.request.graph</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="state"/>
                <field name="no_of_positions" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="recruitment_request_action" model="ir.actions.act_window">
        <field name="name">Recruitment Requests</field>
        <field name="res_model">recruitment.request</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{}</field>
    </record>

    <record id="recruitment_request_action_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">recruitment.request</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="context">{}</field>
    </record>

    <!-- Pricing Views -->
    <record id="recruitment_pricing_view_tree" model="ir.ui.view">
        <field name="name">recruitment.pricing.tree</field>
        <field name="model">recruitment.pricing</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="emp_contract_type"/>
                <field name="min_experience"/>
                <field name="max_experience"/>
                <field name="min_salary" widget="monetary"/>
                <field name="max_salary" widget="monetary"/>
                <field name="percentage"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="recruitment_pricing_action" model="ir.actions.act_window">
        <field name="name">Pricing Rules</field>
        <field name="res_model">recruitment.pricing</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Additional Services Views -->
    <record id="recruitment_additional_service_view_tree" model="ir.ui.view">
        <field name="name">recruitment.additional.service.tree</field>
        <field name="model">recruitment.additional.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="product_id"/>
                <field name="price" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="recruitment_additional_service_action" model="ir.actions.act_window">
        <field name="name">Additional Services</field>
        <field name="res_model">recruitment.additional.service</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>