<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Recruitment Request List View -->
    <record id="recruitment_request_view_tree" model="ir.ui.view">
        <field name="name">recruitment.request.tree</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <list string="Recruitment Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="no_of_positions"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <!-- <field name="final_amount" widget="monetary"/> Removed as per requirement -->
                <field name="submission_date"/>
                <field name="state"/>
                <field name="priority" widget="priority"/>
            </list>
        </field>
    </record>

    <!-- Recruitment Request Form View -->
    <record id="recruitment_request_view_form" model="ir.ui.view">
        <field name="name">recruitment.request.form</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <form string="Recruitment Request">
                <header>
                    <button name="action_send_quotation" string="Create Quotation" type="object"
                            class="oe_highlight" invisible="sale_order_id or state in ('completed', 'cancelled')"
                            groups="recruitment_management.group_recruitment_user"/>
                    <button name="action_convert_to_job" string="Convert to Job" type="object"
                            class="oe_highlight" invisible="state not in ('approved', 'in_progress') or job_count > 0"
                            groups="recruitment_management.group_recruitment_user"/>
                    <button name="action_update_delivered_qty" string="Update Delivered Qty" type="object"
                            class="btn-success" invisible="state not in ('approved', 'in_progress') or not sale_order_id"
                            groups="recruitment_management.group_recruitment_user"/>
                    <button name="action_complete" string="Mark as Completed" type="object"
                            class="btn-primary" invisible="state not in ('approved', 'in_progress') or invoice_count == 0"
                            groups="recruitment_management.group_recruitment_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('completed', 'cancelled')"
                            groups="recruitment_management.group_recruitment_manager"/>
                    <field name="state" widget="statusbar"/>
                    <field name="invoicing_policy" invisible="1"/>
                    <field name="hired_count" invisible="1"/>
                    <field name="uninvoiced_hired_count" invisible="1"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lead" type="object" class="oe_stat_button"
                                icon="fa-bullhorn" invisible="not lead_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">CRM Lead</span>
                            </div>
                        </button>
                        <button name="action_view_job" type="object" class="oe_stat_button"
                                icon="fa-briefcase" invisible="job_count == 0">
                            <field name="job_count" widget="statinfo" string="Job Positions"/>
                        </button>
                        <button name="action_view_applicants" type="object" class="oe_stat_button"
                                icon="fa-users" invisible="applicant_count == 0">
                            <field name="applicant_count" widget="statinfo" string="Applicants"/>
                        </button>
                        <button name="action_view_sale_order" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="not sale_order_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Sales Order</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Employer Information">
                            <field name="partner_id"/>
                            <field name="contact_person_id"/>
                            <field name="user_id" groups="recruitment_management.group_recruitment_user"/>
                            <field name="priority" widget="priority"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Summary">
                            <field name="no_of_positions" readonly="1"/>
                            <field name="is_portal_request" widget="boolean_toggle"
                                   groups="recruitment_management.group_recruitment_user"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Job Positions" name="job_positions">
                            <field name="line_ids" context="{'default_request_id': id}"/>
                            <group class="oe_subtotal_footer">
                                <field name="no_of_positions" class="oe_subtotal_footer_separator" widget="statinfo" string="Total Positions"/>
                                <!-- <field name="service_fee" class="oe_subtotal_footer_separator" widget="monetary"/> Removed as per requirement -->
                            </group>
                        </page>

                        <page string="Additional Info" name="additional_info">
                            <group>
                                <group string="Location &amp; Schedule">
                                    <field name="work_location"/>
                                    <field name="remote_work"/>
                                    <field name="expected_start_date"/>
                                    <field name="deadline_date"/>
                                </group>
                                <group string="Common Benefits">
                                    <field name="benefits" widget="html" nolabel="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- Pricing tab commented out as per requirement -->
                        <!--
                        <page string="Pricing" name="pricing" groups="recruitment_management.group_recruitment_user">
                            <group>
                                <group string="Service Fees">
                                    <field name="service_fee" widget="monetary"/>
                                    <field name="additional_services" widget="many2many_tags"/>
                                    <field name="additional_fee" widget="monetary"/>
                                    <field name="total_amount" widget="monetary"/>
                                </group>
                                <group string="Discount">
                                    <field name="discount_percentage"/>
                                    <field name="discount_amount" widget="monetary"/>
                                    <field name="final_amount" widget="monetary"/>
                                </group>
                            </group>
                            <group>
                                <group string="Invoicing">
                                    <field name="invoicing_policy" widget="radio"/>
                                    <field name="hired_count" readonly="1" string="Hired Applicants" invisible="invoicing_policy != 'hired'"/>
                                    <field name="invoiced_count" readonly="1" string="Invoiced Hired" invisible="invoicing_policy != 'hired'"/>
                                    <label for="invoicing_policy" string="Invoicing Progress" invisible="invoicing_policy != 'hired'"/>
                                    <div invisible="invoicing_policy != 'hired'">
                                        <field name="invoiced_count" readonly="1" class="oe_inline"/> /
                                        <field name="hired_count" readonly="1" class="oe_inline"/> hired applicants invoiced
                                    </div>
                                    <field name="invoiced_hired_applicant_ids" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        -->

                        <page string="Timeline" name="timeline" groups="recruitment_management.group_recruitment_user">
                            <group>
                                <group string="Dates">
                                    <field name="submission_date"/>
                                    <field name="review_date"/>
                                    <field name="approval_date"/>
                                </group>
                                <group string="Related">
                                    <field name="lead_id"/>
                                    <field name="sale_order_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                            <group>
                                <group string="Invoicing">
                                    <field name="invoicing_policy" widget="radio"/>
                                    <field name="hired_count" readonly="1" string="Hired Applicants" invisible="invoicing_policy != 'hired'"/>
                                    <field name="invoiced_count" readonly="1" string="Invoiced Hired" invisible="invoicing_policy != 'hired'"/>
                                    <field name="uninvoiced_hired_count" readonly="1" string="Uninvoiced Hired" invisible="invoicing_policy != 'hired'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Notes" name="notes" groups="recruitment_management.group_recruitment_user">
                            <field name="internal_notes" widget="html"/>
                            <field name="rejection_reason" invisible="state != 'cancelled'" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
               <chatter/>
            </form>
        </field>
    </record>


    <!-- Kanban View -->
    <record id="recruitment_request_view_kanban" model="ir.ui.view">
        <field name="name">recruitment.request.kanban</field>
        <field name="model">recruitment.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="partner_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="no_of_positions"/>
                <field name="work_location"/>
                <field name="submission_date"/>
                <field name="expected_start_date"/>
                <field name="user_id"/>
                <!-- <field name="final_amount"/> Removed as per requirement -->
                <field name="currency_id"/>
                <field name="remote_work"/>
                <field name="color"/>
                <progressbar field="state" colors='{"draft": "secondary", "submitted": "info", "under_review": "primary", "quotation_sent": "warning", "approved": "success", "in_progress": "success", "completed": "primary", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click {{record.priority.raw_value == '1' ? 'oe_kanban_color_' + (record.color.raw_value || 0) : ''}}" style="border-radius: 8px; position: relative; overflow: hidden;">
                            <!-- Custom Status Ribbon with Better Design -->
                            <div t-attf-class="status-ribbon #{
                                record.state.raw_value === 'draft' ? 'ribbon-draft' :
                                record.state.raw_value === 'submitted' ? 'ribbon-submitted' :
                                record.state.raw_value === 'under_review' ? 'ribbon-review' :
                                record.state.raw_value === 'quotation_sent' ? 'ribbon-quotation' :
                                record.state.raw_value === 'approved' ? 'ribbon-approved' :
                                record.state.raw_value === 'in_progress' ? 'ribbon-progress' :
                                record.state.raw_value === 'completed' ? 'ribbon-completed' :
                                record.state.raw_value === 'cancelled' ? 'ribbon-cancelled' : 'ribbon-draft'}">
                                <t t-if="record.state.raw_value === 'draft'">DRAFT</t>
                                <t t-elif="record.state.raw_value === 'submitted'">SUBMITTED</t>
                                <t t-elif="record.state.raw_value === 'under_review'">REVIEW</t>
                                <t t-elif="record.state.raw_value === 'quotation_sent'">QUOTATION</t>
                                <t t-elif="record.state.raw_value === 'approved'">APPROVED</t>
                                <t t-elif="record.state.raw_value === 'in_progress'">IN PROGRESS</t>
                                <t t-elif="record.state.raw_value === 'completed'">COMPLETED</t>
                                <t t-elif="record.state.raw_value === 'cancelled'">CANCELLED</t>
                            </div>

                            <style>
                                .status-ribbon {
                                    position: absolute;
                                    top: 12px;
                                    right: -35px;
                                    transform: rotate(45deg);
                                    padding: 6px 45px;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 1px;
                                    box-shadow: 0 3px 10px rgba(0,0,0,0.3);
                                    z-index: 10;
                                    text-align: center;
                                    color: white;
                                }
                                .ribbon-draft { background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%); }
                                .ribbon-submitted { background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%); }
                                .ribbon-review { background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%); }
                                .ribbon-quotation { background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%); color: #000; }
                                .ribbon-approved { background: linear-gradient(135deg, #198754 0%, #157347 100%); }
                                .ribbon-progress { background: linear-gradient(135deg, #20c997 0%, #1aa179 100%); }
                                .ribbon-completed { background: linear-gradient(135deg, #6610f2 0%, #5a0dd4 100%); }
                                .ribbon-cancelled { background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); }
                                .oe_kanban_card { max-height: 280px; }
                            </style>

                            <div class="oe_kanban_content p-2">
                                <!-- Header -->
                                <div class="o_kanban_record_top mb-2 d-flex align-items-start">
                                    <div class="o_kanban_record_headings flex-grow-1 me-2" style="padding-right: 30px;">
                                        <strong class="o_kanban_record_title d-block mb-1" style="font-size: 14px; line-height: 1.3;">
                                            <field name="partner_id"/>
                                        </strong>
                                        <div class="o_kanban_record_subtitle text-muted" style="font-size: 11px;">
                                            <i class="fa fa-hashtag me-1" style="font-size: 9px;" title="Request Number"/>
                                            <field name="name"/>
                                        </div>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown ms-auto" style="margin-top: -4px;">
                                        <a class="dropdown-toggle o-no-caret btn btn-sm p-0" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" data-bs-display="static" style="color: #6c757d;">
                                            <span class="fa fa-ellipsis-v"/>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-end" role="menu">
                                            <t t-if="widget.editable">
                                                <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                            </t>
                                            <t t-if="widget.deletable">
                                                <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                            </t>
                                            <ul class="oe_kanban_colorpicker" data-field="color"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Priority Row -->
                                <div class="d-flex align-items-center justify-content-end mb-2 pb-1" style="border-bottom: 1px solid #e9ecef;">
                                    <field name="priority" widget="priority"/>
                                </div>

                                <!-- Job Details Grid (2 columns) -->
                                <div class="o_kanban_record_body">
                                    <div class="row g-1">
                                        <!-- Left Column -->
                                        <div class="col-6">
                                            <!-- Location -->
                                            <div class="d-flex align-items-start mb-1" t-if="record.work_location.raw_value">
                                                <i class="fa fa-map-marker text-primary me-1" title="Location" style="width: 12px; font-size: 11px;"/>
                                                <div class="flex-grow-1">
                                                    <small class="text-muted d-block" style="line-height: 1.3; font-size: 10px;">
                                                        <field name="work_location"/>
                                                    </small>
                                                    <t t-if="record.remote_work.raw_value">
                                                        <span class="badge bg-success mt-1" style="font-size: 7px; padding: 1px 4px;">
                                                            <i class="fa fa-home" title="Remote Work"/>Remote
                                                        </span>
                                                    </t>
                                                </div>
                                            </div>

                                            <!-- Submission Date -->
                                            <div class="d-flex align-items-center mb-1" t-if="record.submission_date.raw_value">
                                                <i class="fa fa-calendar text-warning me-1" title="Submission Date" style="width: 12px; font-size: 11px;"/>
                                                <small class="text-muted flex-grow-1" style="font-size: 10px;">
                                                    <field name="submission_date" widget="date"/>
                                                </small>
                                            </div>
                                        </div>

                                        <!-- Right Column -->
                                        <div class="col-6">
                                            <!-- Number of Positions -->
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fa fa-users text-success me-1" title="Number of Positions" style="width: 12px; font-size: 11px;"/>
                                                <small class="text-muted flex-grow-1" style="font-size: 10px;">
                                                    <field name="no_of_positions"/> Position<t t-if="record.no_of_positions.raw_value > 1">s</t>
                                                </small>
                                            </div>

                                            <!-- Expected Start Date -->
                                            <div class="d-flex align-items-center mb-1" t-if="record.expected_start_date.raw_value">
                                                <i class="fa fa-calendar-check-o text-primary me-1" title="Expected Start" style="width: 12px; font-size: 11px;"/>
                                                <small class="text-muted flex-grow-1" style="font-size: 10px;">
                                                    <field name="expected_start_date" widget="date"/>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Footer with Assignee and Amount -->
                                <div class="o_kanban_record_bottom mt-2 pt-2" style="border-top: 1px solid #e9ecef;">
                                    <!-- Amount Row - Removed as per requirement -->
                                    <!--
                                    <div class="d-flex align-items-center justify-content-between mb-2" t-if="record.final_amount.raw_value">
                                        <span class="text-muted" style="font-size: 10px;">
                                            <i class="fa fa-money text-success me-1" title="Amount"/>
                                            Amount:
                                        </span>
                                        <strong class="text-success" style="font-size: 13px;">
                                            <field name="final_amount" widget="monetary"/>
                                        </strong>
                                    </div>
                                    -->
                                    <!-- User and Activity -->
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

