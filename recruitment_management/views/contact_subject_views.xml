<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contact Subject List View -->
    <record id="view_contact_subject_tree" model="ir.ui.view">
        <field name="name">contact.subject.list</field>
        <field name="model">contact.subject</field>
        <field name="arch" type="xml">
            <list string="Contact Subjects">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Contact Subject Form View -->
    <record id="view_contact_subject_form" model="ir.ui.view">
        <field name="name">contact.subject.form</field>
        <field name="model">contact.subject</field>
        <field name="arch" type="xml">
            <form string="Contact Subject">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Contact Subject Action -->
    <record id="action_contact_subject" model="ir.actions.act_window">
        <field name="name">Contact Subjects</field>
        <field name="res_model">contact.subject</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new contact subject
            </p>
            <p>
                Define subjects that will appear in the contact us form dropdown.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_contact_subject"
        name="Contact Subjects"
        parent="crm.crm_menu_config"
        action="action_contact_subject"
        sequence="100"/>

    <!-- Add subject_id field to CRM Lead Form View -->
    <record id="view_crm_lead_form_inherit_subject" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.subject</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="subject_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add subject_id field to CRM Lead Tree View -->
    <record id="view_crm_lead_tree_inherit_subject" model="ir.ui.view">
        <field name="name">crm.lead.tree.inherit.subject</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="subject_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
