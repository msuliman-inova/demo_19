            <field name="no_of_positions">1</field>
            <field name="emp_contract_type" ref="hr.contract_type_permanent"/>
            <field name="experience_years">3</field>
            <field name="job_description"><![CDATA[
                <p>Seeking a creative and results-driven Digital Marketing Manager to lead our marketing initiatives.</p>
                <p><strong>Key Responsibilities:</strong></p>
                <ul>
                    <li>Develop and execute digital marketing strategies</li>
                    <li>Manage social media campaigns and content</li>
                    <li>Analyze campaign performance and optimize ROI</li>
                    <li>Collaborate with design and content teams</li>
                </ul>
            ]]></field>
            <field name="requirements"><![CDATA[
                <ul>
                    <li>Bachelor's degree in Marketing or related field</li>
                    <li>3+ years of digital marketing experience</li>
                    <li>Proven track record of successful campaigns</li>
                    <li>Strong knowledge of SEO, SEM, and social media</li>
                    <li>Excellent analytical and communication skills</li>
                </ul>
            ]]></field>
            <field name="salary_from">10000</field>
            <field name="salary_to">15000</field>
        </record>

