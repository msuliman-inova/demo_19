            <field name="phone">+971-4-123-4567</field>
            <field name="street">Sheikh Zayed Road</field>
            <field name="city">Dubai</field>
            <field name="country_id" ref="base.ae"/>
        </record>

        <!-- Demo Company: Digital Marketing Hub -->
        <record id="partner_demo_employer_2" model="res.partner">
