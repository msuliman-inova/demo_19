<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_statement_of_accounts" model="ir.actions.report">
        <field name="name">Statement of Accounts</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">it_reports.report_statement_of_accounts</field>
        <field name="report_file">it_reports.report_statement_of_accounts</field>
        <field name="print_report_name">'Statement of Accounts - %s' % (object.name)</field>
    </record>

    <template id="report_statement_of_accounts">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="env.company"/>
                <t t-set="stmt" t-value="doc._get_statement_of_accounts_data(date_to if date_to else None)"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="row mb-4">
                            <div class="col-6">
                                <table class="table table-bordered mb-0">
                                    <tr>
                                        <td class="text-center" colspan="2">
                                            <strong>Statement of Accounts</strong><br/>
                                            <em>For the period till <span t-esc="stmt['date_to']" t-options='{"widget": "date"}'/></em>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="2">
                                            <strong>Name</strong>: <span t-esc="doc.name"/><br/>
                                            <strong>Street</strong>: <span t-esc="doc.street or ''"/><br/>
                                            <strong>City</strong>: <span t-esc="doc.city or ''"/><br/>
                                            <strong>PO Box</strong>: <span t-esc="doc.street2 or ''"/><br/>
                                            <strong>Tel</strong>: <span t-esc="doc.phone or ''"/><br/>
                                            <strong>Pay Terms</strong>: <span t-esc="doc.property_payment_term_id.name or ''"/><br/>
                                            <strong>Credit Limit</strong>: <span t-esc="doc.credit_limit"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <strong t-esc="company.name"/><br/>
                                <span t-esc="company.street or ''"/><br/>
                                <span t-field="company.phone"/>
                                <br/><br/>
                                <strong>Attn</strong>: Accounts Manager<br/>
                                <strong>Run Date</strong>: <span t-esc="datetime.date.today()" t-options='{"widget": "date"}'/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered" style="font-size: 10px;">
                            <thead>
                                <tr>
                                    <th>Invoice Date</th>
                                    <th>Invoice No</th>
                                    <th>LPO</th>
                                    <t t-foreach="stmt['buckets']" t-as="bucket">
                                        <th class="text-end"><t t-esc="bucket"/></th>
                                    </t>
                                    <th class="text-end">DSO</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Cumm.Bal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="stmt['lines']" t-as="line">
                                    <td><span t-esc="line['invoice_date']" t-options='{"widget": "date"}'/></td>
                                    <td><span t-esc="line['invoice_no']"/></td>
                                    <td><span t-esc="line['lpo']"/></td>
                                    <t t-foreach="stmt['buckets']" t-as="bucket">
                                        <td class="text-end">
                                            <span t-if="line['bucket'] == bucket"
                                                  t-esc="line['amount']"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id or company.currency_id}'/>
                                        </td>
                                    </t>
                                    <td class="text-end"><span t-esc="line['dso']"/></td>
                                    <td class="text-end">
                                        <span t-esc="line['amount']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="line['cumulative']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-center">Total</td>
                                    <t t-foreach="stmt['buckets']" t-as="bucket">
                                        <td class="text-end">
                                            <span t-esc="stmt['totals'][bucket]" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </t>
                                    <td class="text-end"><span t-esc="stmt['weighted_dso']"/></td>
                                    <td class="text-end">
                                        <span t-esc="stmt['total_amount']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                    </td>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>

                        <div t-if="stmt['cheques']" class="mt-4">
                            <strong>Post Dated Cheques uncleared</strong>
                            <table class="table table-sm table-bordered mt-2">
                                <thead>
                                    <tr>
                                        <th>Document #</th>
                                        <th>Cheque Drawn On</th>
                                        <th>Cheque No.</th>
                                        <th>Actual Cheque Date</th>
                                        <th>Promise Date</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="stmt['cheques']" t-as="cheque">
                                        <td><span t-field="cheque.document_number"/></td>
                                        <td><span t-field="cheque.bank_id.name"/></td>
                                        <td><span t-field="cheque.cheque_number"/></td>
                                        <td><span t-field="cheque.cheque_date"/></td>
                                        <td><span t-field="cheque.promise_date"/></td>
                                        <td class="text-end">
                                            <span t-field="cheque.amount" t-options='{"widget": "monetary", "display_currency": cheque.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td colspan="5" class="text-end">PDC Total</td>
                                        <td class="text-end">
                                            <span t-esc="stmt['cheques_total']" t-options='{"widget": "monetary", "display_currency": company.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="text-muted"><em>Note: All PDCs are subject to realisation from bank.</em></p>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
