<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_statement_of_accounts_wizard_form" model="ir.ui.view">
        <field name="name">account.statement.of.accounts.wizard.form</field>
        <field name="model">account.statement.of.accounts.wizard</field>
        <field name="arch" type="xml">
            <form string="Statement of Accounts">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button string="Print" name="action_print" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_statement_of_accounts_wizard" model="ir.actions.act_window">
        <field name="name">Statement of Accounts</field>
        <field name="res_model">account.statement.of.accounts.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
