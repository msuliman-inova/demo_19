<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_it_reports_do_number" model="ir.ui.view">
        <field name="name">account.move.form.inherit.it.reports.do.number</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='delivery_date']" position="after">
                <field name="delivery_order_number"/>
            </xpath>
        </field>
    </record>
</odoo>
