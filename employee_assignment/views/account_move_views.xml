<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Assigned Employee to Invoice Form View -->
    <record id="view_account_move_form_assigned_employee" model="ir.ui.view">
        <field name="name">account.move.form.assigned.employee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="assigned_employee_id"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="state in ('posted', 'cancel')"/>
            </xpath>
        </field>
    </record>

    <!-- Add Assigned Employee to Invoice Tree View -->
    <record id="view_account_move_tree_assigned_employee" model="ir.ui.view">
        <field name="name">account.move.tree.assigned.employee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_user_id']" position="after">
                <field name="assigned_employee_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Add Assigned Employee Filter and Group By to Invoice Search View -->
    <record id="view_account_move_search_assigned_employee" model="ir.ui.view">
        <field name="name">account.move.search.assigned.employee</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='myinvoices']" position="after">
                <separator/>
                <filter string="My Assigned Invoices" name="my_assigned"
                        domain="[('assigned_employee_id.user_id', '=', uid)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Assigned Employee" name="group_assigned_employee"
                        context="{'group_by': 'assigned_employee_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
